{
  "name": "captionsmith",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "description": "Add captions to any video — transcribed on your own machine.",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:web": "sh web/fetch-whisper.sh && vite build -c web/vite.config.ts",
    "dev:web": "vite -c web/vite.config.ts",
    "preview:web": "vite preview -c web/vite.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^3.8.1",
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.11"
  }
}
